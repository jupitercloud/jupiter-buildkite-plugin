#!/usr/bin/env bash
set -euo pipefail

[[ $# -ge 5 && "$1" == -n && "$2" == /run/current-system/profile/bin/btrfs ]] || exit 90
printf '%q ' sudo "$@" >> "$TEST_MOCK_LOG"
printf '\n' >> "$TEST_MOCK_LOG"
if [[ "${TEST_SUDO_FAIL:-}" == 1 ]]; then
    echo 'sudo: a password is required' >&2
    exit 1
fi
shift 2
export TEST_BTRFS_VIA_SUDO=1
exec "$(dirname "${BASH_SOURCE[0]}")/btrfs" "$@"
