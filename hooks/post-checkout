#!/usr/bin/env bash
set -euo pipefail

: "${BUILDKITE_BUILD_CHECKOUT_PATH:?Buildkite checkout path is required}"
: "${JUPITER_ROOT:?Jupiter pre-checkout hook must run first}"

integration_helper=integrate-submodule.scm
if [[ "${BUILDKITE_PLUGIN_JUPITER_ROOT_REPO:-false}" == true ]]; then
  echo "--- Integrating root repository into Jupiter"
  integration_helper=integrate-root.scm
else
  echo "--- Integrating component into Jupiter"
fi
app_repo="$BUILDKITE_BUILD_CHECKOUT_PATH"
integrated_repo_path="$(guile --no-auto-compile \
  "$(dirname "${BASH_SOURCE[0]}")/../lib/$integration_helper" \
  "$app_repo" "$JUPITER_ROOT")"

# Publish the real checkout path for later hooks, commands, and artifacts.
cd "$integrated_repo_path"
export BUILDKITE_BUILD_CHECKOUT_PATH="$integrated_repo_path"
rm -rf -- "$app_repo"
